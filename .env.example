# Copy to .dev.vars and fill in the keys with a text editor; restart the workbench afterwards.
# Local recognition, cutouts and LaMa background repair need no API keys.
# The following are optional, only for actual 3D generation.
# Never use NEXT_PUBLIC_ or VITE_ for credentials.
WORLDLABS_API_KEY=""
TRIPO_API_KEY=""
# Spending caps the server enforces across all spaces (each World Labs room reserves 230 credits,
# each Tripo piece 30, released again when a job fails). Without these lines: 6770 and 5000.
WORLDLABS_CREDIT_LIMIT="6770"
TRIPO_CREDIT_LIMIT="5000"
