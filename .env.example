# Copy to .dev.vars for local Cloudflare/Vinext development.
# Local recognition, cutouts and LaMa background repair need no API keys.
# The following are optional, only for actual 3D generation.
# Never use NEXT_PUBLIC_ or VITE_ for credentials.
WORLDLABS_API_KEY=""
TRIPO_API_KEY=""
# Optional legacy cloud image provider. Not required by localhost mode.
FAL_KEY=""
# 7000 original budget minus 230 credits used in the recorded smoke test.
WORLDLABS_CREDIT_LIMIT="6770"
# Tripo cap is server-enforced at 5000, with conservative 100-credit reservations.
